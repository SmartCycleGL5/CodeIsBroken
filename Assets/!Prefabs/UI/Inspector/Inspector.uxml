<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/!Prefabs/UI/Inspector/InspectorStyle.uss?fileID=7433441132597879392&amp;guid=7b8b37e22260f26d99349f0b9995d4c2&amp;type=3#InspectorStyle" />
    <ui:VisualElement name="Holder" focusable="true" class="Holder" style="transition-duration: 0.2s; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; justify-content: space-between; align-self: center; flex-direction: row; height: 100%;">
        <ui:VisualElement name="Inspector" picking-mode="Ignore" class="Element" style="align-items: center;">
            <ui:ScrollView name="ScriptHolder" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" picking-mode="Ignore" style="height: 85%; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; align-self: stretch;" />
            <ui:Button text="Add Script" name="AddScript" class="BottomButton" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
