:root {
}

.unity-button:hover {
    scale: 1.05 1.05 1.05;
    transition-timing-function: ease-in-out;
    transition-duration: 0.1s;
}

.unity-button:active {
    transition-timing-function: ease-in-out;
    transition-duration: 0.1s;
    scale: 1 1;
}

.unity-button {
    transition-timing-function: ease-in-out;
    transition-duration: 0.1s;
}
